generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MarketStatus {
  ACTIVE
  PAUSED
}

enum InventoryReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
  FULFILLED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  PROCESSING
  READY_TO_DISPATCH
  DISPATCHED
  DELIVERED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum ShipmentStatus {
  QUOTE_PENDING
  CREATING
  READY
  PACKED
  DISPATCHED
  IN_TRANSIT
  CUSTOMS_HOLD
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum ExportStatus {
  NOT_REQUIRED
  PENDING_REVIEW
  APPROVED
  REJECTED
  DOCUMENTS_PENDING
  CLEARED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum ProviderCallState {
  NOT_SENT
  SENDING
  SENT
  REJECTED
  UNKNOWN
}

enum StockMovementReason {
  RECEIPT
  RESERVATION_RELEASE
  DISPATCH
  SALE_RETURN
  DAMAGE
  WRITE_OFF
  STOCKTAKE
  CORRECTION
  RECALL
}

model Product {
  id             String             @id @default(cuid())
  slug           String             @unique
  name           String
  description    String             @db.Text
  brand          String?
  originCountry  String             @default("NG")
  status         RecordStatus       @default(DRAFT)
  /// Search engine listing; empty means "use the name and description".
  seoTitle       String?
  seoDescription String?
  categoryId     String?
  category       Category?          @relation(fields: [categoryId], references: [id])
  media          ProductMedia[]
  attributes     ProductAttribute[]
  variants       ProductVariant[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status, categoryId])
}

model Category {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  parentId  String?
  parent    Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]   @relation("CategoryTree")
  products  Product[]
  sortOrder Int          @default(0)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model ProductVariant {
  id             String                 @id @default(cuid())
  productId      String
  product        Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku            String                 @unique
  barcode        String?                @unique
  name           String?
  packSize       String
  weightGrams    Int?
  lengthMm       Int?
  widthMm        Int?
  heightMm       Int?
  status         RecordStatus           @default(DRAFT)
  balances       InventoryBalance[]
  reservations   InventoryReservation[]
  batches        InventoryBatch[]
  marketProducts MarketProduct[]
  orderItems     OrderItem[]
  movements      InventoryMovement[]
  cartItems      CartItem[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([productId, status])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String  @db.Text

  @@unique([productId, key])
}

model Market {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  countryCode     String
  currency        String
  status          MarketStatus    @default(PAUSED)
  /// Payment gateway used at checkout for this market ("paystack" or "whop").
  paymentProvider String          @default("paystack")
  marketProducts  MarketProduct[]
  orders          Order[]
  shippingRules   ShippingRule[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model MarketProduct {
  id               String         @id @default(cuid())
  marketId         String
  market           Market         @relation(fields: [marketId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceMinor       BigInt
  compareAtMinor   BigInt?
  currency         String
  exportEligible   Boolean        @default(false)
  minShelfLifeDays Int?
  restrictionNotes String?        @db.Text
  status           RecordStatus   @default(DRAFT)

  @@unique([marketId, variantId])
  @@index([marketId, status])
}

model InventoryLocation {
  id           String                 @id @default(cuid())
  code         String                 @unique
  name         String
  addressJson  Json
  active       Boolean                @default(true)
  balances     InventoryBalance[]
  reservations InventoryReservation[]
  batches      InventoryBatch[]
  movements    InventoryMovement[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model InventoryBalance {
  id               String            @id @default(cuid())
  variantId        String
  variant          ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  locationId       String
  location         InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  quantityOnHand   Int               @default(0)
  reservedQuantity Int               @default(0)
  updatedAt        DateTime          @updatedAt

  @@unique([variantId, locationId])
  @@index([locationId])
}

model InventoryBatch {
  id                String            @id @default(cuid())
  variantId         String
  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  locationId        String
  location          InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  batchCode         String
  receivedAt        DateTime          @default(now())
  expiryDate        DateTime?
  quantityReceived  Int
  quantityRemaining Int
  quarantined       Boolean           @default(false)
  supplierRef       String?
  createdAt         DateTime          @default(now())

  @@unique([variantId, locationId, batchCode])
  @@index([expiryDate, quarantined])
}

model InventoryReservation {
  id         String                     @id @default(cuid())
  variantId  String
  variant    ProductVariant             @relation(fields: [variantId], references: [id], onDelete: Restrict)
  locationId String
  location   InventoryLocation          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  orderId    String?
  order      Order?                     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  quantity   Int
  status     InventoryReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  @@index([status, expiresAt])
  @@index([orderId])
}

model InventoryMovement {
  id            String              @id @default(cuid())
  variantId     String
  variant       ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  locationId    String
  location      InventoryLocation   @relation(fields: [locationId], references: [id], onDelete: Restrict)
  quantityDelta Int
  reason        StockMovementReason
  reference     String?
  note          String?             @db.Text
  actorId       String?
  createdAt     DateTime            @default(now())

  @@index([variantId, locationId, createdAt])
}

model Customer {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String?
  phone           String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  addresses       CustomerAddress[]
  orders          Order[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model CustomerAddress {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label        String?
  recipient    String
  phone        String?
  line1        String
  line2        String?
  city         String
  region       String?
  postalCode   String?
  countryCode  String
  deliveryNote String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String?
  sessionKey String?    @unique
  marketCode String
  currency   String
  status     String     @default("ACTIVE")
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId, status])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

model Order {
  id                     String                 @id @default(cuid())
  orderNumber            String                 @unique
  customerId             String?
  customer               Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  marketId               String
  market                 Market                 @relation(fields: [marketId], references: [id], onDelete: Restrict)
  email                  String
  phone                  String?
  currency               String
  status                 OrderStatus            @default(PENDING_PAYMENT)
  subtotalMinor          BigInt
  discountMinor          BigInt                 @default(0)
  shippingMinor          BigInt                 @default(0)
  taxMinor               BigInt                 @default(0)
  totalMinor             BigInt
  shippingAddressJson    Json
  billingAddressJson     Json?
  customerNote           String?                @db.Text
  destinationCountry     String
  requiresExport         Boolean                @default(false)
  paymentExpiresAt       DateTime
  confirmedAt            DateTime?
  cancelledAt            DateTime?
  checkoutIdempotencyKey String?                @unique
  checkoutRequestHash    String?
  items                  OrderItem[]
  reservations           InventoryReservation[]
  payments               PaymentTransaction[]
  shipments              Shipment[]
  exportRecord           ExportRecord?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([status, paymentExpiresAt])
  @@index([customerId, createdAt])
}

model OrderItem {
  id                  String         @id @default(cuid())
  orderId             String
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId           String
  variant             ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productNameSnapshot String
  skuSnapshot         String
  packSizeSnapshot    String
  quantity            Int
  unitPriceMinor      BigInt
  discountMinor       BigInt         @default(0)
  taxMinor            BigInt         @default(0)
  lineTotalMinor      BigInt
  batchCodeSnapshot   String?
  createdAt           DateTime       @default(now())

  @@index([orderId])
}

model PaymentTransaction {
  id                    String        @id @default(cuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider              String
  providerReference     String        @unique
  idempotencyKey        String        @unique
  currency              String
  amountMinor           BigInt
  status                PaymentStatus @default(INITIATED)
  /// What Paystack's Verify API says was actually charged; may differ from amountMinor.
  receivedAmountMinor   BigInt?
  receivedCurrency      String?
  authorizationUrl      String?
  providerTransactionId String?
  paidAt                DateTime?
  verifiedAt            DateTime?
  rawStatus             String?
  failureReason         String?
  metadataJson          Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  refunds               Refund[]

  @@index([orderId, status])
  @@index([status, createdAt])
}

/// Durable store of every signed provider notification. The unique payload hash
/// makes retried and replayed deliveries no-ops.
model PaymentEvent {
  id          String             @id @default(cuid())
  provider    String
  eventType   String
  payloadHash String
  reference   String?
  payloadJson Json
  status      PaymentEventStatus @default(RECEIVED)
  attempts    Int                @default(0)
  lastError   String?            @db.Text
  receivedAt  DateTime           @default(now())
  processedAt DateTime?

  @@unique([provider, payloadHash])
  @@index([status, receivedAt])
  @@index([reference])
}

model Refund {
  id                String             @id @default(cuid())
  paymentId         String
  payment           PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amountMinor       BigInt
  currency          String
  reason            String
  status            PaymentStatus      @default(REFUND_PENDING)
  idempotencyKey    String             @unique
  providerCallState ProviderCallState  @default(NOT_SENT)
  providerRef       String?            @unique
  failureReason     String?            @db.Text
  requestedBy       String?
  approvedBy        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([paymentId, status])
  @@index([providerCallState])
}

model ShippingRule {
  id             String   @id @default(cuid())
  marketId       String
  market         Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  countryCode    String
  regionCode     String?
  providerCode   String
  serviceCode    String?
  enabled        Boolean  @default(false)
  flatRateMinor  BigInt?
  currency       String?
  minOrderMinor  BigInt?
  maxWeightGrams Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([marketId, countryCode, enabled])
}

model Shipment {
  id                String         @id @default(cuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  idempotencyKey    String         @unique
  attempts          Int            @default(0)
  failureReason     String?        @db.Text
  providerCode      String?
  serviceCode       String?
  trackingNumber    String?
  trackingUrl       String?
  status            ShipmentStatus @default(QUOTE_PENDING)
  destinationJson   Json
  parcelWeightGrams Int?
  shippingMinor     BigInt
  currency          String
  dispatchedAt      DateTime?
  deliveredAt       DateTime?
  providerMetadata  Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([trackingNumber])
}

model ExportRecord {
  id                     String       @id @default(cuid())
  orderId                String       @unique
  order                  Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  destinationCountry     String
  status                 ExportStatus @default(PENDING_REVIEW)
  productEligibilityJson Json
  documentsJson          Json?
  reviewedBy             String?
  reviewedAt             DateTime?
  rejectionReason        String?      @db.Text
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model Promotion {
  id         String    @id @default(cuid())
  code       String?   @unique
  name       String
  type       String
  value      Int
  currency   String?
  startsAt   DateTime?
  endsAt     DateTime?
  usageLimit Int?
  usageCount Int       @default(0)
  active     Boolean   @default(false)
  rulesJson  Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  requestId  String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

enum StaffRole {
  OWNER
  ADMIN
  FINANCE
  FULFILMENT
  CATALOGUE
  EDITOR
  VIEWER
}

/// Back-office accounts. Passwords are scrypt hashes; sessions are opaque random
/// tokens stored only as SHA-256 hashes.
model StaffUser {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String
  passwordHash      String
  role              StaffRole      @default(VIEWER)
  active            Boolean        @default(true)
  failedLoginCount  Int            @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime       @default(now())
  sessions          StaffSession[]
  posts             Post[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model StaffSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  staffUserId String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([staffUserId])
  @@index([expiresAt])
}

/// Runtime configuration edited from the admin. Keys and value shapes are
/// defined (and validated) in src/lib/settings.ts.
model StoreSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model JobRun {
  id          String    @id @default(cuid())
  name        String
  status      String
  triggeredBy String
  resultJson  Json?
  error       String?   @db.Text
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([name, startedAt])
}

/// Third-party integrations configured from the admin. Secrets are stored only
/// as AES-256-GCM ciphertext (key: INTEGRATIONS_ENCRYPTION_KEY); environment
/// variables, when set, take precedence over anything stored here.
model Integration {
  key             String    @id
  enabled         Boolean   @default(false)
  settingsJson    Json      @default("{}")
  secretsCipher   String?   @db.Text
  secretHints     Json      @default("{}")
  lastTestAt      DateTime?
  lastTestOk      Boolean?
  lastTestMessage String?   @db.Text
  updatedBy       String?
  updatedAt       DateTime  @updatedAt
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Outbox for customer emails: written in the same transaction as the event
/// that causes it, delivered afterwards, retried by the reconciliation job.
model Notification {
  id                String             @id @default(cuid())
  kind              String
  dedupeKey         String             @unique
  toEmail           String
  subject           String
  payloadJson       Json
  status            NotificationStatus @default(PENDING)
  attempts          Int                @default(0)
  lastError         String?            @db.Text
  providerMessageId String?
  orderId           String?
  createdAt         DateTime           @default(now())
  sentAt            DateTime?

  @@index([status, createdAt])
  @@index([orderId])
}

/**
 * ------------------------------------------------------------- blog & pages
 */

enum PostType {
  POST
  PAGE
}

enum PostStatus {
  DRAFT
  PUBLISHED
  TRASHED
}

/// Blog posts and standalone pages. The editor's JSON is the source of truth;
/// sanitised HTML and plain text are rendered from it on every save.
model Post {
  id               String         @id @default(cuid())
  type             PostType       @default(POST)
  title            String
  slug             String
  excerpt          String?        @db.Text
  contentJson      Json
  contentHtml      String         @db.Text
  contentText      String         @db.Text
  wordCount        Int            @default(0)
  status           PostStatus     @default(DRAFT)
  /// Live when PUBLISHED and publishedAt <= now; a later date means scheduled.
  publishedAt      DateTime?
  featuredImageUrl String?
  featuredImageAlt String?
  authorId         String?
  author           StaffUser?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categories       BlogCategory[]
  tags             BlogTag[]
  /// Products shown under the post ("Shop this post").
  productIds       String[]       @default([])
  /// Pages only: listed in the shop footer.
  showInFooter     Boolean        @default(false)
  seoTitle         String?
  seoDescription   String?
  focusKeyphrase   String?
  canonicalUrl     String?
  noindex          Boolean        @default(false)
  socialImageUrl   String?
  seoScore         Int?
  readabilityScore Int?
  trashedAt        DateTime?
  revisions        PostRevision[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([type, slug])
  @@index([type, status, publishedAt])
}

/// Saved versions of a post, newest kept; restoring copies one back into the post.
model PostRevision {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  title       String
  excerpt     String?  @db.Text
  contentJson Json
  authorId    String?
  createdAt   DateTime @default(now())

  @@index([postId, createdAt])
}

model BlogCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  sortOrder   Int      @default(0)
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogTag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  posts     Post[]
  createdAt DateTime @default(now())
}

/// Old address -> new address. Created automatically when a published post's
/// address changes, or by staff.
model Redirect {
  id        String    @id @default(cuid())
  fromPath  String    @unique
  toPath    String
  permanent Boolean   @default(true)
  hits      Int       @default(0)
  lastHitAt DateTime?
  note      String?
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Uploaded images, reusable across posts, pages and products.
model Media {
  id          String   @id @default(cuid())
  url         String
  storageKey  String?
  fileName    String
  contentType String
  sizeBytes   Int
  altText     String   @default("")
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
