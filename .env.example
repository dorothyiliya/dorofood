# Copy to .env (never commit .env). Everything that moves money is OFF unless explicitly configured.

# PostgreSQL. Local: npm run db:test:up starts one in Docker on port 54329.
DATABASE_URL="postgresql://dorocity:dorocity_local_only@127.0.0.1:54329/dorocity"

# Integration tests TRUNCATE every table; the database name must end in _test.
TEST_DATABASE_URL="postgresql://dorocity:dorocity_local_only@127.0.0.1:54329/dorocity_test"

# Public site origin, used for Paystack's return URL (e.g. https://www.example.com). Required for checkout.
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Checkout stays disabled (HTTP 503) until this is exactly "true". Leave unset until launch sign-off.
CHECKOUT_ENABLED=""

# Paystack SECRET key (server only; never prefix with NEXT_PUBLIC_). Also used to verify webhook signatures.
# sk_test_... for sandbox. An sk_live_ key is refused unless PAYSTACK_ALLOW_LIVE_KEYS="true".
PAYSTACK_SECRET_KEY=""
PAYSTACK_ALLOW_LIVE_KEYS=""
# Only for tests/local fakes. Live keys are only ever sent to https://api.paystack.co.
# PAYSTACK_API_BASE_URL="https://api.paystack.co"

# Bearer token for /api/internal/jobs/reconcile (at least 32 random characters). Generate: openssl rand -hex 32
CRON_SECRET=""

# Optional
# FULFILMENT_LOCATION_CODE="NG-MAIN"
# PAYMENT_WINDOW_MINUTES="30"
