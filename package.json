{
  "name": "dorocity-food",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "db:test:up": "docker run -d --name dorocity-pg -e POSTGRES_USER=dorocity -e POSTGRES_PASSWORD=dorocity_local_only -e POSTGRES_DB=dorocity -p 127.0.0.1:54329:5432 postgres:16-alpine",
    "db:deploy": "prisma migrate deploy",
    "check": "npm run typecheck && npm run lint && npm run test:all && npm run build",
    "test:smoke": "tsx scripts/smoke-e2e.ts",
    "admin:create": "tsx --conditions=react-server scripts/admin-create.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.16.2",
    "aws4fetch": "^1.0.20",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.6",
    "prisma": "^6.16.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
